# > customization >
PROMPT='λ '
bindkey -v
# < customization <

# >> aliases >>
alias tooling="cd /Users/admin/projects/tooling; nix flake update ; home-manager switch --flake ~/projects/tooling ; cd ~-"

alias i2ml="cd /Users/admin/projects/lecture_i2ml ; code ."
alias sl="cd /Users/admin/projects/lecture_sl ; code ."
alias slds="cd /Users/admin/projects/i2ml ; code ."
# << aliases <<


# >>> conda initialize >>>
# !! Contents within this block are managed by 'conda init' !!
__conda_setup="$('/opt/homebrew/Caskroom/miniconda/base/bin/conda' 'shell.zsh' 'hook' 2> /dev/null)"
if [ $? -eq 0 ]; then
    eval "$__conda_setup"
else
    if [ -f "/opt/homebrew/Caskroom/miniconda/base/etc/profile.d/conda.sh" ]; then
        . "/opt/homebrew/Caskroom/miniconda/base/etc/profile.d/conda.sh"
    else
        export PATH="/opt/homebrew/Caskroom/miniconda/base/bin:$PATH"
    fi
fi
unset __conda_setup
# <<< conda initialize <<<
