PROMPT='λ '
bindkey -v
# < customization <

# >> aliases >>
alias upgrade="cd /Users/admin/projects/tooling; nix flake update; home-manager switch --flake ~/projects/tooling; brew update; brew upgrade; brew bundle dump --file=~/projects/tooling/Brewfile --force; git add .; git commit -m \$(date +'%y-%m-%d'); cd ~-"
